APP_NAME=LostLink AI
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./lostlink.db
CORS_ORIGINS=http://localhost:3000

# LINE Developers
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embedding models
E5_MODEL=intfloat/multilingual-e5-base
SIGLIP_MODEL=google/siglip2-base-patch16-256
MATCH_NOTIFY_THRESHOLD=0.75
MATCH_REVIEW_THRESHOLD=0.60
ADMIN_API_KEY=
