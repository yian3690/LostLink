APP_NAME=LostLink AI
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./lostlink.db
CORS_ORIGINS=http://localhost:3000

# LINE Developers
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# Local conversational AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90
ITEM_CONFIRMATION_THRESHOLD=0.68
ITEM_WEB_LOOKUP_ENABLED=false
ITEM_WEB_LOOKUP_TIMEOUT_SECONDS=6
ITEM_WEB_LOOKUP_USER_AGENT=LostLink-AI/0.1 (https://github.com/yian3690/LostLink; contact via repository)

# Embedding models
E5_MODEL=intfloat/multilingual-e5-base
SIGLIP_MODEL=google/siglip2-base-patch16-256
MATCH_NOTIFY_THRESHOLD=0.75
MATCH_REVIEW_THRESHOLD=0.60
ADMIN_API_KEY=
